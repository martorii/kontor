{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "kontor",
      "extra-files": [
        "docker-compose.yml",
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='kontor')].version"
        }
      ]
    }
  }
}
