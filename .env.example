# Copy to .env (gitignored) and adjust.

# Log output: "console" (readable, default) or "json".
LOG_FORMAT=console
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Postgres (docker compose). Placeholder dev values: change them in your own .env.
POSTGRES_USER=kontor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kontor
# Host port the API is published on.
API_PORT=8000
# SQLAlchemy URL for local runs (uv run alembic ..., pytest). Compose builds its own from POSTGRES_*.
DATABASE_URL=postgresql+psycopg://kontor:change-me@localhost:5432/kontor
