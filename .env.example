# Copy to .env (gitignored) and adjust.

# Log output: "console" (readable, default) or "json".
LOG_FORMAT=console
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Postgres (docker compose). Placeholder dev values: change them in your own .env.
POSTGRES_USER=kontor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kontor
# Host port the API is published on.
API_PORT=8000
# SQLAlchemy URL for local runs (uv run alembic ..., pytest). Compose builds its own from POSTGRES_*.
DATABASE_URL=postgresql+psycopg://kontor:change-me@localhost:5432/kontor
# Host port the UI is published on.
UI_PORT=8501
# Release image tag that `make deploy` runs. `make rollback TAG=vX.Y.Z` sets it.
# Unset means the version pinned in docker-compose.yml.
# KONTOR_TAG=v0.1.0
# Rules and category tree. Copy config/rules.example.yaml to config/rules.yaml and edit it.
# Local runs read config/rules.yaml by default; compose mounts ./config into the container.
# RULES_PATH=config/rules.yaml

# Categorizer LLM: LM Studio (OpenAI-compatible API) for transaction categories (CONTRACT §7).
# Required: the API refuses to start without the URL and the model.
# Containers reach LM Studio on the host at host.docker.internal; `localhost` inside a
# container is the container itself. For `uv run` on the host, use http://localhost:1234/v1.
CATEGORIZER_LLM_BASE_URL=http://host.docker.internal:1234/v1
# The model id as shown by LM Studio (GET /v1/models).
CATEGORIZER_LLM_MODEL=google_gemma-4-e2b-it
# CATEGORIZER_LLM_API_KEY=lm-studio
# CATEGORIZER_LLM_TIMEOUT_SECONDS=60
# Below this probability the LLM answer is only a suggestion (CONTRACT §7.4).
# CATEGORIZER_LLM_CONFIDENCE_THRESHOLD=0.95
# Concurrent LLM calls (CONTRACT §8.6) and transactions per committed batch (§8.4).
# CATEGORIZER_LLM_CONCURRENCY=4
# CATEGORIZER_LLM_BATCH_SIZE=10

# Text-to-SQL agent (CONTRACT §16.3): statement timeout and row cap for its queries.
# AGENT_STATEMENT_TIMEOUT_SECONDS=10
# AGENT_MAX_ROWS=500
